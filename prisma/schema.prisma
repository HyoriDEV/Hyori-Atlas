// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMMUNICATION
  CONFLICT_MANAGEMENT
  RP_TRACKING
  DEVELOPER
  PLAYER
}

enum RegistrationStatus {
  NEW
  WAITLIST
  WHITELIST_IN_PROGRESS
  WHITELISTED
  REJECTED
}

enum NewsType {
  ANNOUNCEMENT
  CHANGELOG
}

enum TicketCategory {
  GENERAL_QUESTION
  WHITELIST
  RP_REQUEST
  PLAYER_COMPLAINT
  BUG_REPORT
}

enum TicketStatus {
  PENDING_STAFF
  PENDING_PLAYER
  ARCHIVED
}

enum TicketMessageAuthorType {
  PLAYER
  SYSTEM
}

model User {
  id String @id @default(cuid())

  discordId          String             @unique
  discordUsername    String
  discordDisplayName String
  discordAvatarUrl   String?
  minecraftUuid      String?            @unique
  minecraftUsername  String?
  role               Role               @default(PLAYER)
  registrationStatus RegistrationStatus @default(NEW)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  accounts            Account[]
  sessions            Session[]
  news                News[]
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  registrationHistory RegistrationStatusHistory[]

  @@map("users")
}

model RegistrationStatusHistory {
  id        String             @id @default(cuid())
  userId    String
  status    RegistrationStatus
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("registration_status_history")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model News {
  id          String   @id @default(cuid())
  type        NewsType
  title       String
  excerpt     String
  content     String?
  authorId    String?
  authorLabel String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("news")
}

model Ticket {
  id        String         @id @default(cuid())
  playerId  String
  category  TicketCategory
  subject   String
  status    TicketStatus   @default(PENDING_STAFF)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  player   User            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id         String                  @id @default(cuid())
  ticketId   String
  authorType TicketMessageAuthorType
  authorId   String?
  body       String
  createdAt  DateTime                @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("ticket_messages")
}
