// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COMMUNICATION
  CONFLICT_MANAGEMENT
  RP_TRACKING
  DEVELOPER
  PLAYER
}

enum RegistrationStatus {
  NEW
  WAITLIST
  WHITELIST_IN_PROGRESS
  WHITELISTED
  REJECTED
}

enum NewsType {
  ANNOUNCEMENT
  CHANGELOG
}

enum TicketCategory {
  GENERAL_QUESTION
  WHITELIST
  RP_REQUEST
  PLAYER_COMPLAINT
  BUG_REPORT
}

enum TicketStatus {
  PENDING_STAFF
  PENDING_PLAYER
  ARCHIVED
}

enum ConversationType {
  TICKET
  RP_TRACKING
}

enum MessageAuthorType {
  PLAYER
  STAFF
  SYSTEM
}

enum Gender {
  Homme
  Femme
  Autre
}

enum CharacterSheetStatus {
  DRAFT
  PENDING_PLAYER
  PENDING_STAFF
  VALIDATED
}

enum CharacterSheetCommentTarget {
  name
  nickname
  age
  gender
  civilStatus
  heightCm
  description
  background
  additionalComments
  skillMap
}

enum InterviewBookingStatus {
  REGISTERED
  CHANGES_REQUESTED
  ACCEPTED
}

model User {
  id String @id @default(cuid())

  discordId          String             @unique
  discordUsername    String
  discordDisplayName String
  discordAvatarUrl   String?
  minecraftUuid      String?            @unique
  minecraftUsername  String?
  role               Role               @default(PLAYER)
  registrationStatus RegistrationStatus @default(NEW)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  accounts                Account[]
  sessions                Session[]
  news                    News[]
  tickets                 Ticket[]
  registrationHistory     RegistrationStatusHistory[]
  conversationMemberships ConversationMember[]
  conversationMessages    ConversationMessage[]
  characterSheet          CharacterSheet?
  interviewBookings       InterviewBooking[]
  staffNotes              StaffNote[]                 @relation("StaffNotePlayer")
  authoredStaffNotes      StaffNote[]                 @relation("StaffNoteAuthor")
  chapters                Chapter[]

  authoredStatusChanges     RegistrationStatusHistory[] @relation("RegistrationStatusHistoryAuthor")
  reviewedInterviewBookings InterviewBooking[]          @relation("InterviewBookingReviewer")

  authoredSheetComments CharacterSheetComment[]       @relation("CharacterSheetCommentAuthor")
  authoredSheetReviews  CharacterSheetReviewHistory[] @relation("CharacterSheetReviewAuthor")
  bdaPartyMemberships   BdaPartyMember[]
  createdBdaReports     BdaReport[]                   @relation("BdaReportCreator")
  bdaStaffMemberships   BdaStaffMember[]
  updatedGlobalSettings GlobalSettings[]
  minecraftAuthCodes    MinecraftAuthCode[]
  minecraftAuthAttempts MinecraftAuthAttempt[]

  @@map("users")
}

model RegistrationStatusHistory {
  id        String             @id @default(cuid())
  userId    String
  authorId  String?
  status    RegistrationStatus
  createdAt DateTime           @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  author User? @relation("RegistrationStatusHistoryAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@map("registration_status_history")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model News {
  id          String   @id @default(cuid())
  type        NewsType
  title       String
  excerpt     String
  content     String?
  authorId    String?
  authorLabel String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("news")
}

model Ticket {
  id             String         @id @default(cuid())
  playerId       String
  category       TicketCategory
  subject        String
  status         TicketStatus   @default(PENDING_STAFF)
  conversationId String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  player       User         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bdaReport    BdaReport?

  @@map("tickets")
}

model CharacterSheet {
  id       String @id @default(cuid())
  playerId String @unique

  name               String  @db.VarChar(50)
  nickname           String? @db.VarChar(50)
  age                Int
  gender             Gender
  civilStatus        String  @db.VarChar(50)
  heightMeters       Float
  description        String  @db.VarChar(2000)
  background         String  @db.VarChar(2000)
  additionalComments String? @db.VarChar(300)

  physicalForce        Int @default(1)
  physicalEndurance    Int @default(1)
  physicalStealth      Int @default(1)
  physicalDexterity    Int @default(1)
  mentalIntelligence   Int @default(1)
  mentalComposure      Int @default(1)
  mentalWeaponsMastery Int @default(1)
  socialCharisma       Int @default(1)
  socialPersuasion     Int @default(1)
  socialViolence       Int @default(1)

  reviewStatus      CharacterSheetStatus @default(DRAFT)
  hasUnreadFeedback Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  player        User                          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  comments      CharacterSheetComment[]
  reviewHistory CharacterSheetReviewHistory[]

  @@map("character_sheets")
}

model CharacterSheetComment {
  id       String  @id @default(cuid())
  sheetId  String
  authorId String?

  target CharacterSheetCommentTarget
  body   String                      @db.VarChar(1000)

  quotedText   String? @db.VarChar(500)
  anchorStart  Int?
  anchorPrefix String? @db.VarChar(64)
  anchorSuffix String? @db.VarChar(64)

  createdAt DateTime @default(now())

  sheet  CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  author User?          @relation("CharacterSheetCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sheetId])
  @@map("character_sheet_comments")
}

model CharacterSheetReviewHistory {
  id           String               @id @default(cuid())
  sheetId      String
  authorId     String?
  status       CharacterSheetStatus
  commentCount Int                  @default(0)
  note         String?              @db.VarChar(500)
  createdAt    DateTime             @default(now())

  sheet  CharacterSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  author User?          @relation("CharacterSheetReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sheetId])
  @@map("character_sheet_review_history")
}

model InterviewSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  createdAt DateTime @default(now())

  booking InterviewBooking?

  @@map("interview_slots")
}

model InterviewBooking {
  id           String                 @id @default(cuid())
  slotId       String                 @unique
  playerId     String
  reviewedById String?
  status       InterviewBookingStatus @default(REGISTERED)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  slot     InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  player   User          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  reviewer User?         @relation("InterviewBookingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@map("interview_bookings")
}

model StaffNote {
  id        String   @id @default(cuid())
  playerId  String
  authorId  String?
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  player User  @relation("StaffNotePlayer", fields: [playerId], references: [id], onDelete: Cascade)
  author User? @relation("StaffNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@map("staff_notes")
}

model Chapter {
  id        String   @id @default(cuid())
  playerId  String
  title     String   @db.VarChar(120)
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player User @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("chapters")
}

model Conversation {
  id   String           @id @default(cuid())
  type ConversationType

  ticket Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages ConversationMessage[]

  @@map("conversations")
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model ConversationMessage {
  id             String            @id @default(cuid())
  conversationId String
  authorType     MessageAuthorType
  authorId       String?
  body           String?
  imageUrl       String?
  linkHref       String?
  linkLabel      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  deletedAt      DateTime?

  conversation Conversation                 @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?                        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  versions     ConversationMessageVersion[]

  @@index([conversationId])
  @@map("conversation_messages")
}

model ConversationMessageVersion {
  id        String   @id @default(cuid())
  messageId String
  body      String?
  createdAt DateTime @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("conversation_message_versions")
}

enum BdaReportStatus {
  UNREAD
  RESOLVED
  ARCHIVED
}

model BdaReport {
  id          String          @id @default(cuid())
  title       String          @db.VarChar(120)
  description String          @db.Text
  status      BdaReportStatus @default(UNREAD)

  ticketId    String? @unique // Optional link to a PLAYER_COMPLAINT ticket
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy    User?            @relation("BdaReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  ticket       Ticket?          @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  parties      BdaParty[]
  attachments  BdaAttachment[]
  staffMembers BdaStaffMember[]

  @@map("bda_reports")
}

model BdaStaffMember {
  id       String @id @default(cuid())
  reportId String
  userId   String

  report BdaReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
  @@map("bda_staff_members")
}

model BdaParty {
  id       String @id @default(cuid())
  reportId String
  name     String @db.VarChar(100)

  report  BdaReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  members BdaPartyMember[]

  @@map("bda_parties")
}

model BdaPartyMember {
  id      String @id @default(cuid())
  partyId String
  userId  String

  party BdaParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([partyId, userId])
  @@index([userId])
  @@map("bda_party_members")
}

model BdaAttachment {
  id        String   @id @default(cuid())
  reportId  String
  url       String
  createdAt DateTime @default(now())

  report BdaReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("bda_attachments")
}

model GlobalSettings {
  id                         String   @id @default("global")
  registrationEnabled        Boolean  @default(true)
  interviewBookingEnabled    Boolean  @default(true)
  ticketCreationEnabled      Boolean  @default(true)
  rpTrackingAccessEnabled    Boolean  @default(true)
  chapterWritingEnabled      Boolean  @default(true)
  bdaReportSubmissionEnabled Boolean  @default(true)
  minecraftServerAddress     String   @default("link.hyorirp.fr")
  minecraftServerVersion     String   @default("1.21.11")
  minecraftAuthCommand       String   @default("auth")
  countdownEnabled           Boolean  @default(false)
  countdownBadgeText         String?  @default("Hyori RP — Lancement Officiel")
  countdownTitle             String   @default("Lancement Officiel de Hyori RP")
  countdownSubtitle          String?  @default("Le compte à rebours est lancé. Préparez-vous à entrer dans l'histoire.")
  countdownTargetDate        DateTime?
  countdownVideoType         String   @default("URL")
  countdownVideoUrl          String?
  countdownDiscordUrl        String?  @default("https://discord.gg/hyori")
  updatedAt                  DateTime @updatedAt
  updatedById                String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("global_settings")
}

model MinecraftAuthCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("minecraft_auth_codes")
}

model MinecraftAuthAttempt {
  id                String   @id @default(cuid())
  code              String?
  minecraftUuid     String?
  minecraftUsername String?
  ipAddress         String?
  success           Boolean
  reason            String?
  userId            String?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([minecraftUuid])
  @@index([ipAddress])
  @@index([userId])
  @@map("minecraft_auth_attempts")
}
