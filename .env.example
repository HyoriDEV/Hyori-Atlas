# =============================================================================
# HYORI ATLAS - Environment Variables Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# -----------------------------------------------------------------------------
# Production example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=prefer
DATABASE_URL=postgresql://hyori:hyori_dev@localhost:5432/hyori_atlas

# -----------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5)
# -----------------------------------------------------------------------------
# Generate a secure secret with: openssl rand -hex 32
AUTH_SECRET=

# Public canonical URL of the application (e.g. https://atlas.hyori.fr)
NEXTAUTH_URL=http://localhost:3000

# Required when running in Docker behind a reverse proxy (Nginx, Traefik, Caddy, Coolify, Dokku)
AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------------
# Discord OAuth2 Provider
# -----------------------------------------------------------------------------
# From Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: Bot token to fetch user avatars and profiles if user OAuth access token expires
DISCORD_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Security & Debug Options
# -----------------------------------------------------------------------------
# In production, dev authentication bypass is disabled by default.
# Set to "true" only if you explicitly need test accounts in a staging environment.
ALLOW_DEV_AUTH=false

# -----------------------------------------------------------------------------
# Minecraft Plugin Server Integration
# -----------------------------------------------------------------------------
# Shared secret between Atlas API and Minecraft plugin (Authorization: Bearer <key>)
MINECRAFT_API_KEY=hyori_minecraft_secret_key_change_me_in_prod

# -----------------------------------------------------------------------------
# Server Runtime (Optional - already defaulted in Dockerfile.prod)
# -----------------------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0
